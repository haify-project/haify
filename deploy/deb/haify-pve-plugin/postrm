#!/bin/sh
# postrm for haify-pve-plugin.
#
# After removal the daemons are restarted so they drop the module, as
# install.sh --uninstall does. The LVM filter lvm-filter.sh added stays in
# lvm.conf: it only keeps the host's LVM off DRBD devices, which is right with
# or without the plugin, and lvm.conf is the operator's file.

set -e

case "$1" in
remove)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl try-restart pvedaemon pveproxy pvestatd pvescheduler pve-ha-crm pve-ha-lrm || true
    fi
    ;;
purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
*)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
