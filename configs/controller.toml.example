# Haify Controller Configuration

[server]
listen_address = "0.0.0.0"
port = 3374
# REST gateway (grpc-gateway); the web UI proxies /v1/ to it on loopback.
rest_port = 3375

[database]
# Database file path (default: /var/lib/haify/haify.db)
path = "/var/lib/haify/haify.db"

[dispatch]
# SSH configuration the controller uses to reach storage nodes.
# config_path matters whenever the controller does NOT run as a user whose
# ~/.dispatch/config.toml is the intended one (systemd unit with its own HOME,
# non-root operator, test harness). Leave it empty to keep dispatch's default
# discovery. A path that does not exist is rejected at startup.
config_path = "/root/.dispatch/config.toml"
# Max nodes a single dispatch call fans out to. 0 = built-in default (10).
parallel = 10

[wan]
# Controller-side cache for the shared CA + leaf used by the haify-proxy mTLS link
# (opt-in WAN replication only). Defaults to /var/lib/haify/wanproxy-pki, which
# only a root controller can create — point it somewhere writable otherwise.
# pki_dir = "/var/lib/haify/wanproxy-pki"

# Transport security for the gRPC API. The REST gateway and the web UI ride on
# the same server through an in-process hop, so they follow automatically.
#
# With this off, bearer tokens ([auth]/[rbac] below) cross the network in the
# clear; the controller says so in its startup log.
#
# NOTE: ca_cert / client_cert / client_key described a *client* and were never
# read by anything. A config still carrying them is now rejected at startup —
# replace them with cert_file/key_file below. The client-side spellings live on
# as haify's --tls-ca / --tls-cert / --tls-key.
[tls]
enabled = false
# The certificate this controller presents, and its private key.
# cert_file = "/etc/haify/certs/server.crt"
# key_file = "/etc/haify/certs/server.key"
# Setting a client CA is what turns on mutual TLS: clients must then present a
# certificate signed by it, and one that is not gets no further than the
# handshake. Leave it unset for server-only TLS.
# client_ca_file = "/etc/haify/certs/client-ca.crt"
# Serve the REST gateway ([server] rest_port) over TLS too, with the same
# certificate. Off by default: REST clients written for plain HTTP stop
# working. Client certificates are never asked for on REST.
rest = false

[log]
level = "info"  # debug, info, warn, error
format = "json"  # json or text

[storage]
# What `pool create` builds when no --type is given, for every client: haify,
# the REST gateway, MCP and the web UI alike. Thin is the default because a
# thick pool cannot hold a snapshot history — LVM reserves a fixed COW area per
# snapshot (Haify takes 20% of the origin), so a 10 GiB pool holding a 6 GiB
# volume fits two of them. Set "vg" for thick pools everywhere.
#
# Only LVM types belong here (vg, lvm, lvm-thin, thin-pool, thin_pool). A ZFS
# pool is built from vdevs by a different call, so an omitted type never becomes
# one, and the controller refuses to start rather than accept "zfs" here.
default_pool_type = "thin_pool"
default_snapshot_suffix = "_snap"
# DRBD online verify of every resource, one at a time (cron). Replicas that
# differ raise resource.out_of_sync. "" turns it off.
verify_schedule = "0 3 1 * *"

# Keeping thin pools from filling up. A full thin pool fails writes and DRBD
# drops the disk, so it is prevented rather than alerted on.
[storage.thin]
# fstrim every mounted DRBD filesystem on the node serving it (cron); the
# discards reach every replica's pool. "" turns it off. `haify pool trim` runs it
# now.
trim_schedule = "30 2 * * *"
# Share of a new thin pool's volume group left outside the pool, as room for
# autoextend. `pool add` leaves the same share of a new disk.
reserve_percent = 10
# Once a pool's data or metadata reaches this percentage, grow it: metadata
# doubles, data grows by autoextend_percent of the pool's size (or what the
# group has left). 0 turns it off; otherwise 50-95.
autoextend_threshold = 80
autoextend_percent = 20

[resource]
# Give a 2-node resource a diskless quorum tiebreaker on a third registered
# node, so it keeps quorum through one node loss.
auto_tiebreaker = true
# Node label naming what fails together (e.g. the physical host of a VM).
# Automatic placement spreads replicas and the tiebreaker across its values.
fault_domain_label = "host"

[gateway]
# Add the small cluster-private state volume a gateway needs when the
# resource has only one volume.
auto_state_volume = true
state_volume_size_gb = 1

[schedule]
# Master switch for the scheduler: snapshot and backup schedules,
# [storage] verify_schedule and [inspect] schedule. Off stops them without
# deleting the definitions.
enabled = true

[audit]
# Log every state-changing API call (caller, target, outcome, latency).
enabled = true
include_reads = false
# Kept in the controller database this long, and never more entries than
# max_entries (dropping a younger one raises audit.truncated).
retention_days = 180
max_entries = 200000
# Send every entry off the cluster as it is written, in order, resuming after
# an outage or a failover. "udp://host:514", "tcp://host:514", "tls://host:6514".
syslog = ""
syslog_ca = ""        # PEM bundle for tls://; empty = system roots
# Each batch as a JSON POST; webhook_token is sent as a Bearer token.
webhook_url = ""
webhook_token = ""

[self_ha]
# Extra systemd units the Self-HA promoter starts with the controller, e.g.
# ["haify-ai.service"]. Read when `haify ha self enable` writes the promoter.
extra_services = []

[metrics]
enabled = true
listen_address = "0.0.0.0"
port = 9433
# node_exporter's port on every node (scripts/install-node-exporter.sh); the
# metrics listener serves /discovery/node-exporter for Prometheus with it
node_exporter_port = 39117
# The Prometheus server that scrapes those node_exporters. The dashboard reads
# the nodes' CPU, memory, disk latency and network from it; empty leaves that
# section out.
prometheus_url = ""

[ui]
enabled = true
listen_address = "0.0.0.0"
port = 3376

# Health detection and notifications.
#
# `enabled` starts the detector and the event bus by itself. Delivery is a
# separate, optional concern: with no webhook configured the events are still
# readable at GET /v1/events, streamed at GET /v1/events/watch, pushed to the
# web UI's notification bell over GET /v1/events/stream, and followed with
# `haify event watch`.
[alert]
# The health poll: events, the storage and DRBD gauges in /metrics, the
# write-anomaly guard and thin pool autoextend all read it. Nothing is sent
# anywhere until a notification channel is set up. false stops all of them.
enabled = true
check_interval_sec = 30
# SSH-probe every registered node on each poll. This is what produces
# node.unreachable events, and the only check that costs a round trip per node.
check_nodes = true
# Keep a `drbdsetup events2` stream open to every node, so a DRBD state change
# is checked within seconds; a healthy cluster is then polled every
# idle_interval_sec instead of every check_interval_sec.
watch_drbd_events = true
idle_interval_sec = 300
# A warning must last this long before it is raised. Critical is never held.
warning_hold_sec = 30
# Thin pool data/metadata usage thresholds (percent).
check_pools = true
pool_near_full_percent = 85
pool_full_percent = 95
# Events retained for clients that connect after something happened.
history_size = 500

# Single-receiver shorthand: one POST per event, body is the event JSON.
webhook_url = ""
webhook_min_severity = "warning"   # info | warning | critical

# Additional receivers, each with its own threshold.
# [[alert.webhooks]]
# url = "https://chat.example.com/hooks/haify"
# min_severity = "info"
# headers = { X-Token = "..." }

# Write-anomaly detection, on the same poll: each resource learns its usual
# write rate by hour of the week, and writing factor times that (and at least
# min_mbps) for two polls in a row — a volume being rewritten wholesale, as
# ransomware does — raises resource.write_anomaly, freezes the resource's
# snapshot schedule for freeze_hours (nothing is pruned or deletable) and
# takes a snapshot. A bulk import or a reindex looks the same.
[alert.write_anomaly]
enabled = true
factor = 5.0
min_mbps = 20.0
freeze_hours = 168

# Scheduled cluster inspection (`haify inspect`): read-only checks of what the
# alerts do not cover, stored as reports. Runs on the snapshot scheduler, so
# only on the active controller and only while [schedule] enabled = true.
[inspect]
enabled = true
schedule = "0 1 * * *"   # cron, controller time zone
keep = 30                # reports kept
# Publish inspection.completed when the worst finding is at least this:
# pass (every run) | warn | fail.
notify_min = "warn"

# API authentication. With [auth], one shared bearer token guards every call.
# [rbac] replaces it with per-user tokens and roles (admin, operator, viewer);
# users added later with `haify rbac` are kept in the database.
# [auth]
# enabled = true
# token = "<long random string>"
#
# [rbac]
# enabled = true
# [[rbac.users]]
# name = "ops"
# token = "<long random string>"
# role = "operator"
#
# Two-person approval: deleting data or what protects it (backup targets,
# backups, snapshots, schedules, resources, pools; restores; shortening a
# schedule's retention; user and role changes) waits for a different user with the approve right (admin, or the
# security-officer role) to run `haify approval approve <id>`. Needs [rbac].
# [rbac.approval]
# enabled = true
# ttl_minutes = 60

# Self-healing: replace the replicas of a node that stays unreachable.
# "off" (default), "dry-run" (only say what it would do) or "on". It acts only
# after after_minutes offline, confirmed by the peers' DRBD as well as SSH,
# and only while at most max_offline_percent of the nodes are offline.
[self_heal]
auto_evict = "off"
after_minutes = 60
max_offline_percent = 34

# Quotas. max_overcommit_ratio caps a thin pool's promised size (its thin
# volumes' sizes) at that many times its real size; 0 = unlimited. A
# project's resources are those labelled <project_label>=<name>.
[quota]
max_overcommit_ratio = 0.0
project_label = "project"
# [[quota.projects]]
# name = "team-a"
# max_gb = 2000
# max_resources = 50
